# NVIDIA free-tier API key for Phase 7 LLM translation.
# The Vite dev proxy (vite.config.ts) reads this at server start and injects
# the Authorization header on outgoing requests — the key is NEVER shipped to
# the browser. Production deployments need a real backend proxy.
#
# Get a key: https://build.nvidia.com (free tier, ~1000 requests/day)
VITE_NVIDIA_API_KEY=
