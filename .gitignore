# Env & ML data
.env
.env.local
# Corpora are large (200MB+) and re-downloadable, so they stay out —
# but clips recorded in the app are irreplaceable and tiny (~1MB), and
# they're the only in-domain data the project has. Those get versioned.
ml/data/*
!ml/data/user_clips/

